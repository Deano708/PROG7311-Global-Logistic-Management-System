@* GLMS_MVC / Views / Auth / Login.cshtml *@
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GLMS – Sign In</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://www.gstatic.com/firebasejs/ui/6.1.0/firebase-ui-auth.css" />

    <style>
            body {
                background: #f0f2f5;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
            }

            .login-wrapper {
                width: 100%;
                max-width: 440px;
                padding: 1rem;
            }

            .login-card {
                border: none;
                border-radius: 12px;
                box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);
            }

            .login-header {
                background: #212529;
                color: #fff;
                border-radius: 12px 12px 0 0;
                padding: 1.75rem 2rem 1.5rem;
                text-align: center;
            }

            .login-header h4 {
                margin: 0;
                font-weight: 600;
                letter-spacing: 0.5px;
            }

            .login-header p {
                margin: 0.4rem 0 0;
                font-size: 0.85rem;
                opacity: 0.7;
            }

            .login-body {
                padding: 2rem;
            }

            /* Override FirebaseUI button to match Bootstrap primary */
            .firebaseui-idp-button,
            .mdl-button--raised.mdl-button--colored {
                background-color: #0d6efd !important;
            }

            .firebaseui-title {
                display: none; /* we have our own heading */
            }

            #loader {
                display: none;
                padding: 1rem 0;
            }
    </style>
</head>
<body>

    <div class="login-wrapper">

        <div class="card login-card">

            <div class="login-header">
                <h4>&#127758; Global Logistics</h4>
                <p>Management System</p>
            </div>

            <div class="login-body">

                @* ── Server-side validation errors (e.g. bad token) ── *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <p class="text-muted small mb-3">
                    Sign in with your GLMS account to continue.
                </p>

                @* ── FirebaseUI renders the email/password form here ── *@
                <div id="firebaseui-auth-container"></div>

                @* ── Shown while the MVC AuthController verifies the token ── *@
                <div id="loader" class="text-center">
                    <div class="spinner-border spinner-border-sm text-secondary me-2" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="text-muted small">Verifying credentials&hellip;</span>
                </div>

                @* ── Hidden form submitted by JS after Firebase returns the ID token ── *@
                <form id="tokenForm" asp-controller="Auth" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idToken" name="idToken" />
                    <input type="hidden" id="returnUrl" name="returnUrl" value="@ViewBag.ReturnUrl" />
                </form>

            </div>
        </div>

        <p class="text-center text-muted small mt-3">
            &copy; @DateTime.Now.Year Global Logistics Management System
        </p>

    </div>

    @* ── Firebase SDKs ── *@
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/ui/6.1.0/firebase-ui-auth.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ── Replace ALL values below with your Firebase project config ──
        // Firebase Console → Project Settings → General → Your apps → Web app
        const firebaseConfig = {
        apiKey: "AIzaSyDCWJMuNcxRKBY7mJkcXDsrQh4w75z2UjU",
        authDomain: "prog7311glms.firebaseapp.com",
        projectId: "prog7311glms",
        storageBucket: "prog7311glms.firebasestorage.app",
        messagingSenderId: "399391096045",
        appId: "1:399391096045:web:a5b51642c7177e4e0b20e4"
        };

        // Initialise Firebase
        firebase.initializeApp(firebaseConfig);

        // Initialise FirebaseUI
        const ui = new firebaseui.auth.AuthUI(firebase.auth());

        ui.start('#firebaseui-auth-container', {

        signInOptions: [
        // Email / password – always enabled
        firebase.auth.EmailAuthProvider.PROVIDER_ID

        // Uncomment to add Google sign-in:
        // firebase.auth.GoogleAuthProvider.PROVIDER_ID
        ],

        // Do not redirect automatically – we handle it ourselves below
        signInFlow: 'popup',

        callbacks: {
        signInSuccessWithAuthResult: function (authResult) {
        // Show the loading spinner
        document.getElementById('loader').style.display = 'block';
        document.getElementById('firebaseui-auth-container').style.display = 'none';

        // Get the short-lived ID token and post it to AuthController
        authResult.user.getIdToken(/* forceRefresh */ true)
        .then(function (idToken) {
        document.getElementById('idToken').value = idToken;
        document.getElementById('tokenForm').submit();
        })
        .catch(function (error) {
        console.error('Failed to retrieve ID token:', error);
        document.getElementById('loader').style.display = 'none';
        document.getElementById('firebaseui-auth-container').style.display = 'block';
        alert('Sign-in failed. Please try again.');
        });

        // Return false to prevent FirebaseUI from redirecting on its own
        return false;
        },

        signInFailure: function (error) {
        console.error('Firebase sign-in error:', error);
        // FirebaseUI will display its own inline error message; nothing extra needed
        }
        }
        });
    </script>

</body>
</html>

