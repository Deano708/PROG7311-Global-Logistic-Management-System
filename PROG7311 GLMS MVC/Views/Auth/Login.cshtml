@* GLMS_MVC / Views / Auth / Login.cshtml *@
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GLMS – Sign In</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: #f0f2f5;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
            }
            .login-wrapper {
                width: 100%;
                max-width: 460px;
                padding: 1rem;
            }
            .login-card {
                border: none;
                border-radius: 12px;
                box-shadow: 0 4px 24px rgba(0,0,0,0.10);
            }
            .login-header {
                background: #212529;
                color: #fff;
                border-radius: 12px 12px 0 0;
                padding: 1.75rem 2rem 1.5rem;
                text-align: center;
            }
            .login-header h4 { margin: 0; font-weight: 600; letter-spacing: 0.5px; }
            .login-header p  { margin: 0.4rem 0 0; font-size: 0.85rem; opacity: 0.7; }
            .login-body { padding: 2rem; }
            .nav-tabs .nav-link { color: #495057; font-weight: 500; }
            .nav-tabs .nav-link.active { color: #212529; font-weight: 600; }
            #loader { display: none; padding: 1rem 0; }
            .password-wrapper { position: relative; }
            .toggle-pw {
                position: absolute; right: 10px; top: 50%;
                transform: translateY(-50%);
                background: none; border: none; cursor: pointer;
                color: #6c757d; font-size: 1rem; padding: 0;
            }
            .strength-bar {
                height: 5px; border-radius: 3px;
                transition: width 0.3s, background-color 0.3s;
                width: 0%;
            }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="card login-card">

            <div class="login-header">
                <h4>&#127758; Global Logistics</h4>
                <p>Management System</p>
            </div>

            <div class="login-body">

                @* Server-side errors *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @* JS feedback banner *@
                <div id="jsBanner" class="alert d-none" role="alert"></div>

                @* ── Tabs ── *@
                <ul class="nav nav-tabs mb-4" id="authTabs">
                    <li class="nav-item">
                        <button class="nav-link active" id="signinTab"
                                onclick="showTab('signin')">
                            Sign In
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="registerTab"
                                onclick="showTab('register')">
                            Register
                        </button>
                    </li>
                </ul>

                @* ══════════════════════════════════
               SIGN IN PANEL
               ══════════════════════════════════ *@
                <div id="signinPanel">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email address</label>
                        <input type="email" id="siEmail" class="form-control"
                               placeholder="you@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="siPassword" class="form-control"
                                   placeholder="••••••••" />
                            <button type="button" class="toggle-pw"
                                    onclick="toggleVisibility('siPassword', this)">
                                &#128065;
                            </button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" />
                            <label class="form-check-label small" for="rememberMe">Remember me</label>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                onclick="sendPasswordReset()">
                            Forgot password?
                        </button>
                    </div>
                    <button class="btn btn-dark w-100" onclick="signIn()">Sign In</button>
                </div>

                @* ══════════════════════════════════
               REGISTER PANEL
               ══════════════════════════════════ *@
                <div id="registerPanel" style="display:none;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" id="regName" class="form-control"
                               placeholder="Jane Smith" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email address</label>
                        <input type="email" id="regEmail" class="form-control"
                               placeholder="you@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="regPassword" class="form-control"
                                   placeholder="Min. 6 characters"
                                   oninput="updateStrength(this.value)" />
                            <button type="button" class="toggle-pw"
                                    onclick="toggleVisibility('regPassword', this)">
                                &#128065;
                            </button>
                        </div>
                        <div class="mt-1">
                            <div class="bg-light rounded" style="height:5px;">
                                <div id="strengthBar" class="strength-bar rounded"></div>
                            </div>
                            <small id="strengthLabel" class="text-muted"></small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirm Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="regConfirm" class="form-control"
                                   placeholder="••••••••" />
                            <button type="button" class="toggle-pw"
                                    onclick="toggleVisibility('regConfirm', this)">
                                &#128065;
                            </button>
                        </div>
                    </div>
                    <button class="btn btn-success w-100" onclick="register()">Create Account</button>
                </div>

                @* ── Loading spinner ── *@
                <div id="loader" class="text-center mt-3">
                    <div class="spinner-border spinner-border-sm text-secondary me-2" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="text-muted small">Please wait&hellip;</span>
                </div>

                @* ── Hidden form posted to AuthController after token is received ── *@
                <form id="tokenForm" asp-controller="Auth" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idToken" name="idToken" />
                    <input type="hidden" id="returnUrl" name="returnUrl" value="@ViewBag.ReturnUrl" />
                </form>

            </div>
        </div>

        <p class="text-center text-muted small mt-3">
            &copy; @DateTime.Now.Year Global Logistics Management System
        </p>
    </div>

    @* ── Firebase SDKs ── *@
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ── Replace ALL values with your Firebase project config ──────────────────
        // Firebase Console → Project Settings → General → Your apps → Web app → Config
        const firebaseConfig = {
        apiKey: "AIzaSyDCWJMuNcxRKBY7mJkcXDsrQh4w75z2UjU",
        authDomain: "prog7311glms.firebaseapp.com",
        projectId: "prog7311glms",
        storageBucket: "prog7311glms.firebasestorage.app",
        messagingSenderId: "399391096045",
        appId: "1:399391096045:web:a5b51642c7177e4e0b20e4"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();

        // ── Tab switching ─────────────────────────────────────────────────────────
        function showTab(tab) {
        document.getElementById('signinPanel').style.display  = tab === 'signin'   ? 'block' : 'none';
        document.getElementById('registerPanel').style.display = tab === 'register' ? 'block' : 'none';
        document.getElementById('signinTab').classList.toggle('active',   tab === 'signin');
        document.getElementById('registerTab').classList.toggle('active', tab === 'register');
        hideBanner();
        }

        // ── Banner helpers ────────────────────────────────────────────────────────
        function showBanner(message, type) {
        const b = document.getElementById('jsBanner');
        b.className = `alert alert-${type}`;
        b.textContent = message;
        }
        function hideBanner() {
        document.getElementById('jsBanner').className = 'alert d-none';
        }

        // ── Show / hide password ──────────────────────────────────────────────────
        function toggleVisibility(fieldId, btn) {
        const field = document.getElementById(fieldId);
        field.type = field.type === 'password' ? 'text' : 'password';
        btn.textContent = field.type === 'password' ? '\uD83D\uDC41' : '\uD83D\uDE48';
        }

        // ── Password strength meter ───────────────────────────────────────────────
        function updateStrength(pw) {
        let score = 0;
        if (pw.length >= 6)  score++;
        if (pw.length >= 10) score++;
        if (/[A-Z]/.test(pw)) score++;
        if (/[0-9]/.test(pw)) score++;
        if (/[^A-Za-z0-9]/.test(pw)) score++;

        const bar    = document.getElementById('strengthBar');
        const label  = document.getElementById('strengthLabel');
        const levels = [
        { pct: '20%',  color: '#dc3545', text: 'Very weak'  },
        { pct: '40%',  color: '#fd7e14', text: 'Weak'       },
        { pct: '60%',  color: '#ffc107', text: 'Fair'       },
        { pct: '80%',  color: '#20c997', text: 'Good'       },
        { pct: '100%', color: '#198754', text: 'Strong'     }
        ];
        const lvl = levels[Math.min(score, 4)];
        bar.style.width           = pw.length ? lvl.pct   : '0%';
        bar.style.backgroundColor = pw.length ? lvl.color : 'transparent';
        label.textContent         = pw.length ? lvl.text  : '';
        }

        // ── Loading state ─────────────────────────────────────────────────────────
        function setLoading(on) {
        document.getElementById('loader').style.display = on ? 'block' : 'none';
        }

        // ── Submit token to MVC AuthController ───────────────────────────────────
        function submitToken(idToken) {
        document.getElementById('idToken').value = idToken;
        document.getElementById('tokenForm').submit();
        }

        // ── SIGN IN ───────────────────────────────────────────────────────────────
        function signIn() {
        hideBanner();
        const email    = document.getElementById('siEmail').value.trim();
        const password = document.getElementById('siPassword').value;

        if (!email || !password) {
        showBanner('Please enter your email and password.', 'warning');
        return;
        }

        setLoading(true);

        auth.signInWithEmailAndPassword(email, password)
        .then(cred => cred.user.getIdToken(true))
        .then(submitToken)
        .catch(err => {
        setLoading(false);
        showBanner(friendlyError(err.code), 'danger');
        });
        }

        // ── REGISTER ──────────────────────────────────────────────────────────────
        function register() {
        hideBanner();
        const name     = document.getElementById('regName').value.trim();
        const email    = document.getElementById('regEmail').value.trim();
        const password = document.getElementById('regPassword').value;
        const confirm  = document.getElementById('regConfirm').value;

        if (!name) {
        showBanner('Please enter your full name.', 'warning'); return;
        }
        if (!email) {
        showBanner('Please enter your email address.', 'warning'); return;
        }
        if (password.length < 6) {
        showBanner('Password must be at least 6 characters.', 'warning'); return;
        }
        if (password !== confirm) {
        showBanner('Passwords do not match.', 'warning'); return;
        }

        setLoading(true);

        auth.createUserWithEmailAndPassword(email, password)
        .then(cred => {
        // Save the display name to the Firebase user profile
        return cred.user.updateProfile({ displayName: name })
        .then(() => cred.user.getIdToken(true));
        })
        .then(submitToken)
        .catch(err => {
        setLoading(false);
        showBanner(friendlyError(err.code), 'danger');
        });
        }

        // ── FORGOT PASSWORD ───────────────────────────────────────────────────────
        function sendPasswordReset() {
        hideBanner();
        const email = document.getElementById('siEmail').value.trim();

        if (!email) {
        showBanner('Enter your email address above, then click Forgot password.', 'info');
        return;
        }

        auth.sendPasswordResetEmail(email)
        .then(() => showBanner('Password reset email sent. Check your inbox.', 'success'))
        .catch(err => showBanner(friendlyError(err.code), 'danger'));
        }

        // ── Firebase error → human-readable message ───────────────────────────────
        function friendlyError(code) {
        const map = {
        'auth/user-not-found':       'No account found with that email.',
        'auth/wrong-password':       'Incorrect password. Please try again.',
        'auth/invalid-email':        'That email address is not valid.',
        'auth/email-already-in-use': 'An account with that email already exists.',
        'auth/weak-password':        'Password must be at least 6 characters.',
        'auth/too-many-requests':    'Too many attempts. Please try again later.',
        'auth/network-request-failed': 'Network error. Check your connection.',
        'auth/invalid-credential':   'Invalid email or password.'
        };
        return map[code] ?? 'Something went wrong. Please try again.';
        }

        // Allow Enter key to trigger sign-in
        document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
        const signinVisible = document.getElementById('signinPanel').style.display !== 'none';
        if (signinVisible) signIn(); else register();
        }
        });
    </script>
</body>
</html>
