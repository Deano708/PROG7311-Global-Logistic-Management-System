@* Views/Contracts/Delete.cshtml *@
@model PROG7311GLMS.Models.ContractDto

<div class="container mt-4" style="max-width:560px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Confirm Deletion
            </h5>
        </div>
        <div class="card-body">
            <h6 class="text-muted mb-3">Are you sure you want to delete this contract?</h6>
            <hr />
            <dl class="row mb-0">
                <dt class="col-sm-4">Client</dt>
                <dd class="col-sm-8">@Model.ClientName</dd>

                <dt class="col-sm-4">Service Level</dt>
                <dd class="col-sm-8">@(Model.ServiceLevel ?? "N/A")</dd>

                <dt class="col-sm-4">Start Date</dt>
                <dd class="col-sm-8">@Model.StartDate.ToShortDateString()</dd>

                <dt class="col-sm-4">End Date</dt>
                <dd class="col-sm-8">@Model.EndDate.ToShortDateString()</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @{
                        var sc = Model.StatusName == "Active" ? "success" :
                                 Model.StatusName == "Expired" ? "danger" : "warning";
                    }
                    <span class="badge bg-@sc">@Model.StatusName</span>
                </dd>
            </dl>

            <div class="alert alert-warning mt-3 mb-0">
                <i class="bi bi-exclamation-triangle"></i>
                This action <strong>cannot be undone</strong>. All linked service requests
                will also be removed.
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ContractId" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Yes, Delete
                </button>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</div>
