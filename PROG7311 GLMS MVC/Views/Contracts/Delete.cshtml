@model PROG7311GLMS.Models.ContractDto

<h3>Are you sure you want to delete this contract?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Client</dt>
        <dd class="col-sm-10">@Model.ClientName</dd>
        <dt class="col-sm-2">Dates</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ContractId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
