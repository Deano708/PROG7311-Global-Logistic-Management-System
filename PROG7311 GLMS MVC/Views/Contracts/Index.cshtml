@model IEnumerable<PROG7311GLMS.Models.Contract>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Global Logistics Contracts</h2>
        <a asp-action="Create" class="btn btn-primary">Create New Contract</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 bg-light shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Status</label>
                    <select name="statusId" class="form-select" asp-items="@(new SelectList(ViewBag.Statuses, "StatusId", "StatusName"))">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-dark w-100">Filter Results</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Client Name</th>
                    <th>Service Level</th>
                    <th>Contract Period (Date Range)</th>
                    <th>Current Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Client.Name</td>
                        <td>@(item.ServiceLevel ?? "N/A")</td>
                        <td>
                            <span class="badge bg-secondary">@item.StartDate.ToShortDateString()</span>
                            to
                            <span class="badge bg-secondary">@item.EndDate.ToShortDateString()</span>
                        </td>
                        <td>
                            @{
                                var statusClass = item.Status.StatusName == "Active" ? "success" :
                                                 item.Status.StatusName == "Expired" ? "danger" : "warning";
                            }
                            <span class="badge rounded-pill bg-@statusClass">@item.Status.StatusName</span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="DownloadAgreement" asp-route-id="@item.ContractId" class="btn btn-sm btn-outline-info" title="Download PDF">
                                    <i class="bi bi-file-earmark-pdf"></i> PDF
                                </a>
                                <a asp-action="Duplicate" asp-route-id="@item.ContractId" class="btn btn-sm btn-outline-secondary" title="Clone Contract">
                                    Clone
                                </a>
                                <a asp-controller="ServiceRequests"
                                   asp-action="Index"
                                   asp-route-contractId="@item.ContractId"
                                   class="btn btn-sm btn-success">+ Request</a>
                                <form asp-action="Delete" asp-route-id="@item.ContractId" method="post" onsubmit="return confirm('Are you sure you want to delete this contract? This action cannot be undone.');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>