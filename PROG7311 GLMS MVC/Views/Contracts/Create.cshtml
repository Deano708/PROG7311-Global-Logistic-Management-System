@model PROG7311GLMS.Models.Contract

<h4 class="text-muted">Enter contract details and upload the signed agreement.</h4>

@if (TempData["ModelErrors"] != null)
{
    var errs = System.Text.Json.JsonSerializer.Deserialize<List<string>>(TempData["ModelErrors"].ToString());
    <div class="alert alert-danger">
        <strong>Validation errors:</strong>
        <ul>
            @foreach (var e in errs)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" asp-controller="Contracts" method="post" enctype="multipart/form-data" id="contractForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="ClientId" class="fw-bold">Select Client</label>
        <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientList">
            <option value="">-- Select Client --</option>
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ServiceLevel" class="fw-bold">Service Level Agreement (SLA)</label>
        <input asp-for="ServiceLevel" class="form-control" placeholder="e.g. Priority Shipping" />
        <span asp-validation-for="ServiceLevel" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="fw-bold">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="fw-bold">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group mt-3">
        <label class="fw-bold">Upload Signed PDF Agreement</label>
        <input type="file" name="pdfFile" class="form-control" accept=".pdf,application/pdf" />
        <span class="text-danger" data-valmsg-for="pdfFile"></span>
        <small class="text-muted">Only .pdf files are accepted.</small>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary px-4">Save Contract</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
