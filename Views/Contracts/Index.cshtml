@model IEnumerable<PROG7311GLMS.Models.Contract>

<div class="container">
    <h2>Global Logistics Contracts</h2>

    <div class="card mb-4 bg-light">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Contract Status</label>
                    <select name="statusId" class="form-select" asp-items="@(new SelectList(ViewBag.Statuses, "StatusId", "StatusName"))">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Client</th>
                <th>Service Level</th>
                <th>Date Range</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Client.Name</td>
                    <td>@item.ServiceLevel</td>
                    <td>@item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()</td>
                    <td>@item.Status.StatusName</td>
                    <td>
                        <a asp-action="DownloadAgreement" asp-route-id="@item.ContractId" class="btn btn-sm btn-outline-info">PDF</a>
                        <a asp-action="Duplicate" asp-route-id="@item.ContractId" class="btn btn-sm btn-outline-secondary">Clone</a> <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@item.ContractId" class="btn btn-sm btn-success">+ Request</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
