@model PROG7311GLMS.Models.Contract

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Contracts" asp-action="Index">Contracts</a></li>
            <li class="breadcrumb-item active">Service Requests</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Contract Details</h5>
                </div>
                <div class="card-body">
                    <p><strong>Client:</strong> @Model.Client.Name</p>
                    <p>
                        <strong>Status:</strong>
                        <span class="badge bg-@(Model.Status.StatusName == "Active" ? "success" : "danger")">
                            @Model.Status.StatusName
                        </span>
                    </p>
                    <hr />

                    @if (Model.Status.StatusName == "Active")
                    {
                        <h6>Raise New Request</h6>
                        <form asp-action="Create" method="post">
                            <input type="hidden" name="ContractId" value="@Model.ContractId" />
            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Description</label>
                                <textarea name="Description" class="form-control" rows="3" required></textarea>
                            </div>
            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Cost (USD)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input name="CostUsd" type="number" step="0.01" class="form-control" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100">Submit Request</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 shadow-sm">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Form Locked:</strong> Service requests can only be raised for <b>Active</b> contracts.
                            This contract is currently <strong>@Model.Status.StatusName</strong>.
                        </div>
                        <button class="btn btn-secondary w-100" disabled>Submit Locked</button>
                    }
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Existing Requests for this Contract</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Description</th>
                                <th>Cost (USD)</th>
                                <th>Cost (ZAR)</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sr in Model.ServiceRequests)
                            {
                                <tr>
                                    <td>@sr.Description</td>
                                    <td>$@sr.CostUsd.ToString("N2")</td>
                                    <td>R @sr.CostZar.ToString("N2")</td>
                                    <td><span class="badge bg-secondary">@sr.Status?.StatusName</span></td>
                                    <td>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this request?');">
                                            <input type="hidden" name="id" value="@sr.ServiceRequestId" />
                                            <input type="hidden" name="contractId" value="@Model.ContractId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.ServiceRequests.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No service requests found for this contract.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
